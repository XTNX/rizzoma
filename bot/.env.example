# ============================================================
# Секреты бэкенда. Этот файл — только пример, .env в git не попадает.
# В бою значения живут в переменных окружения хостинга, не в файлах.
# ============================================================

# Токен бота из @BotFather (/newbot или /token).
# Для беты заведи ОТДЕЛЬНОГО бота — продовый не трогай.
BOT_TOKEN=123456:AA...

# Публичный HTTPS-адрес статики мини-приложения (index.html)
APP_URL=https://example.github.io/rizzoma/

# Порт API
PORT=8080

# Откуда разрешены запросы к API — домен статики.
# Для отладки можно *, для боевой версии укажи точный origin.
CORS_ORIGIN=https://example.github.io

# ---------- платежи ----------
# Токен платёжного провайдера: @BotFather → /mybots → выбрать бота →
# Payments → провайдер (ЮKassa / Robokassa / CloudPayments) → Provider token.
# Пока в токене есть TEST — деньги не списываются, это и нужно для беты.
PROVIDER_TOKEN=

# Валюта счёта и цена ОДНОЙ проходки в рублях.
# Пусто — счёт не выставляется, приложение честно пишет «уточняется».
CURRENCY=RUB
PRICE_STD=
PRICE_VIP=

# ---------- бета ----------
# Telegram user id администраторов беты через запятую. Только они
# открывают бета-админку. Пусто — не откроет никто.
# Свой id можно узнать у @userinfobot.
ADMIN_TG_IDS=

# Какие узлы дерева открыты тестерам (индексы TIERS).
# Пусто — берётся BETA_OPEN из economy.js: 0,1,3,4 (ВОЛЯ + ГЛУБИНА).
BETA_OPEN=
