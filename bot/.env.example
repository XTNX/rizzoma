# Токен бота из @BotFather (/newbot или /token)
BOT_TOKEN=123456:AA...

# Публичный HTTPS-адрес статики мини-приложения (index.html)
APP_URL=https://example.github.io/rizzoma/

# Порт API
PORT=8080

# Откуда разрешены запросы к API — домен статики.
# Для отладки можно *, для боевой версии укажи точный origin.
CORS_ORIGIN=https://example.github.io
